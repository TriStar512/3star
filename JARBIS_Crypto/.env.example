# ============================================================
# JARBIS Crypto 24/7 Trading Bot - Environment Configuration
# ============================================================

# ---- Execution venue: Hyperliquid (DEX, Metamask self-custody, no KYC) ----
# Hyperliquid is the single trading venue. Leverage scales dynamically
# with the existing sentiment * volatility * heat formula.
HL_API_URL=https://api.hyperliquid.xyz
HL_WALLET_ADDRESS=
# Only needed when PAPER_TRADE=false. Keep OUT of disk for real use;
# prefer a local keystore or Metamask-signing proxy.
HL_PRIVATE_KEY=
# Hard default ON. Flip to false ONLY after a clean testnet smoke run.
HL_TESTNET=true

PRIMARY_BROKER=hyperliquid

# ---- Read-only data fallbacks (no auth needed for public endpoints) ----
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- Portfolio & Risk ----
PORTFOLIO_SIZE_USD=1000
MAX_LOSS_PCT=0.02
MAX_LEVERAGE=3.0
BASE_LEVERAGE=2.0
MAX_POSITION_SIZE_PCT=0.05
MAX_CONCURRENT_TRADES=4

# ---- Trading Pairs ----
# Only coins in the ALLOWED_COINS top-10 list will be accepted.
# Top-10 (most-liquid perpetuals): BTC, ETH, BNB, SOL, XRP, ADA, DOGE, AVAX, LINK, MATIC
TRADING_PAIRS=BTC,ETH,BNB,SOL,XRP,ADA,DOGE,AVAX,LINK,MATIC
TIMEFRAMES=4h,1h,15m

# ---- Sentiment & News ----
CRYPTOCOMPARE_API_KEY=
SANTIMENT_API_KEY=
NEWSAPI_API_KEY=
GLASSNODE_API_KEY=
NANSEN_API_KEY=

# ---- Webhook & Alerts ----
WEBHOOK_PORT=5000
WEBHOOK_SECRET=change_me_please
SLACK_WEBHOOK_URL=

# ---- Paper/Live & Logging ----
PAPER_TRADE=true
LOG_DB=trades.db
LOG_CSV=trades.csv
LOG_LEVEL=INFO

# ---- Advanced ----
EMERGENCY_IV_RANK_THRESHOLD=0.90
POSITION_TIMEOUT_MINUTES=30
ENABLE_ON_CHAIN_SIGNALS=true
ENABLE_FUNDING_RATE_HARVEST=true
PRIMARY_BROKER=bybit

# ---- Engine ----
SIGNAL_POLL_SECONDS=30
DASHBOARD_REFRESH_SECONDS=2
