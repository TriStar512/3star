# ============================================================
# JARBIS Crypto 24/7 Trading Bot - Environment Configuration
# ============================================================

# ---- Broker API Keys ----
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- Portfolio & Risk ----
PORTFOLIO_SIZE_USD=1000
MAX_LOSS_PCT=0.02
MAX_LEVERAGE=3.0
BASE_LEVERAGE=2.0
MAX_POSITION_SIZE_PCT=0.05
MAX_CONCURRENT_TRADES=4

# ---- Trading Pairs ----
TRADING_PAIRS=BTC,ETH,SOL,XRP
TIMEFRAMES=4h,1h,15m

# ---- Sentiment & News ----
CRYPTOCOMPARE_API_KEY=
SANTIMENT_API_KEY=
NEWSAPI_API_KEY=
GLASSNODE_API_KEY=
NANSEN_API_KEY=

# ---- Webhook & Alerts ----
WEBHOOK_PORT=5000
WEBHOOK_SECRET=change_me_please
SLACK_WEBHOOK_URL=

# ---- Paper/Live & Logging ----
PAPER_TRADE=true
LOG_DB=trades.db
LOG_CSV=trades.csv
LOG_LEVEL=INFO

# ---- Advanced ----
EMERGENCY_IV_RANK_THRESHOLD=0.90
POSITION_TIMEOUT_MINUTES=30
ENABLE_ON_CHAIN_SIGNALS=true
ENABLE_FUNDING_RATE_HARVEST=true
PRIMARY_BROKER=bybit

# ---- Engine ----
SIGNAL_POLL_SECONDS=30
DASHBOARD_REFRESH_SECONDS=2
