# Broker API Keys
BYBIT_API_KEY=xxxxx
BYBIT_API_SECRET=xxxxx
BYBIT_TESTNET=true

BINANCE_API_KEY=xxxxx
BINANCE_API_SECRET=xxxxx
BINANCE_TESTNET=false

# Portfolio & Risk
PORTFOLIO_SIZE_USD=1000
MAX_LOSS_PCT=0.02
MAX_LEVERAGE=3.0
BASE_LEVERAGE=2.0
MAX_POSITION_SIZE_PCT=0.05

# Trading Pairs
TRADING_PAIRS=BTC,ETH,SOL,XRP
TIMEFRAMES=4h,1h,15m

# Sentiment & News
CRYPTOCOMPARE_API_KEY=xxxxx
SANTIMENT_API_KEY=xxxxx
NEWSAPI_API_KEY=xxxxx
GLASSNODE_API_KEY=xxxxx

# Webhook & Alerts
WEBHOOK_PORT=5000
WEBHOOK_SECRET=your_secret_key
SLACK_WEBHOOK_URL=https://hooks.slack.com/...

# Paper/Live & Logging
PAPER_TRADE=true
LOG_DB=trades.db
LOG_CSV=trades.csv

# Advanced
EMERGENCY_IV_RANK_THRESHOLD=0.90
POSITION_TIMEOUT_MINUTES=30
ENABLE_ON_CHAIN_SIGNALS=true
ENABLE_FUNDING_RATE_HARVEST=true
